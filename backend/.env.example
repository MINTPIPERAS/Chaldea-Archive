# 复制为 .env 后按需修改（所有变量均有默认值，后端无 .env 也能启动）

CHALDEA_DATABASE_URL=postgresql+asyncpg://chaldea:chaldea@localhost:5432/chaldea

# Embedding（详见 Docs/embedding-guide.md）
# cloud  = OpenAI 兼容云 API（默认，SiliconFlow 的 bge-m3 免费）
# ollama = 本地 Ollama（http://localhost:11434/v1）
# local  = sentence-transformers 进程内加载（需额外安装 sentence-transformers）
CHALDEA_EMBEDDING_PROVIDER=cloud
CHALDEA_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
CHALDEA_EMBEDDING_API_KEY=
CHALDEA_EMBEDDING_MODEL=BAAI/bge-m3
CHALDEA_EMBEDDING_DIMENSION=1024
